# Example unit for the stand (FIN-149): Go services under systemd, one PostgreSQL.
# Install as /etc/systemd/system/<service>.service, replace "service" with the name.
# The deploy script runs "<binary> migrate up" (same environment) before restarting the unit.
#
# Secrets are systemd credentials, not environment variables: they do not show up in
# "systemctl show" or /proc/<pid>/environ.
#   /etc/finassist/<service>/env            non-secret settings (see docs/config.md)
#   /etc/finassist/<service>/db-primary-dsn DSN, mode 0600, owner root
[Unit]
Description=fin-assist assistant
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/opt/finassist/assistant/assistant serve
EnvironmentFile=/etc/finassist/assistant/env
Environment=ENV=stage
LoadCredential=db-primary-dsn:/etc/finassist/assistant/db-primary-dsn
Environment=DB_PRIMARY_DSN_FILE=%d/db-primary-dsn
# Stage identity (FIN-324): AUTH_MODE=verify with ENV=stage verifies service JWTs
# signed with stage key files; set AUTH_STAGE_ISSUER, AUTH_USER_ISSUER,
# AUTH_USER_AUDIENCE and PEER_USER_ADDR in the env file and pass the key files as
# credentials (read once at start; see docs/config.md):
#LoadCredential=stage-signing-key:/etc/finassist/assistant/stage-signing-key.pem
#Environment=AUTH_STAGE_SIGNING_KEY_FILE=%d/stage-signing-key
#LoadCredential=stage-public-keys:/etc/finassist/assistant/stage-public-keys.json
#Environment=AUTH_STAGE_PUBLIC_KEYS_FILE=%d/stage-public-keys

DynamicUser=yes
Restart=on-failure
RestartSec=2s
# SHUTDOWN_DELAY + SHUTDOWN_TIMEOUT (5s + 20s by default) plus a margin.
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
